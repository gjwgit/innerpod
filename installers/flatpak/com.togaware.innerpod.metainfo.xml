<?xml version="1.0" encoding="UTF-8"?>
<!-- AppStream metadata: what GNOME Software, KDE Discover and Flathub show
     for the app. From the gjwgit/fluttertmpl Copier template, with the
     summary and description from .copier-answers.yml. @VERSION@ and
     @DATE@ are filled in from pubspec.yaml when the Flatpak is built. -->
<component type="desktop-application">
  <id>com.togaware.innerpod</id>
  <name>InnerPod</name>
  <summary>A privacy-first meditation timer</summary>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>GPL-3.0-or-later</project_license>
  <developer id="com.togaware">
    <name>Togaware</name>
  </developer>
  <url type="homepage">https://github.com/gjwgit/innerpod</url>
  <url type="bugtracker">https://github.com/gjwgit/innerpod/issues</url>
  <launchable type="desktop-id">com.togaware.innerpod.desktop</launchable>

  <description>
    <p>
      InnerPod is a session timer typically used for silent meditation.
      Choose a length and a bell. The bell marks the start and the end
      of the session. A guided session is also available with a spoken
      word introduction.
    </p>
    <p>
      Sessions can be logged locally. On your say so, the log can instead
      be encrypted and stored on your own Solid Pod, so nobody, not even
      the server administrator, can see them. If you choose not to share
      the log on your Solid Pod then the timer simply runs and nothing is
      sent anywhere.
    </p>
  </description>

  <categories>
    <category>Utility</category>
    <category>Clock</category>
  </categories>

  <keywords>
    <keyword>meditation</keyword>
    <keyword>timer</keyword>
    <keyword>session</keyword>
    <keyword>bell</keyword>
    <keyword>solid</keyword>
    <keyword>pod</keyword>
  </keywords>

  <content_rating type="oars-1.1"/>

  <releases>
    <release version="@VERSION@" date="@DATE@"/>
  </releases>
</component>
